# Normalizacion de fin de linea. Importa de verdad: un .sh con CRLF no arranca
# dentro del contenedor ni en la Pi.
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.sql     text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.yml     text eol=lf
*.md      text eol=lf

*.jpg binary
*.png binary
*.mp4 binary
