# Copiar a .env para desarrollo fuera de Docker.
# En Docker estos valores vienen de los compose.

# Base de datos y volumenes (rutas locales fuera de contenedor)
ECOMAP_DB=data/ecomap.db
ECOMAP_EFFECTS=effects
ECOMAP_MEDIA=media
ECOMAP_MIGRATIONS_DIR=migrations

# Bus IPC. En Linux/macOS un socket Unix; en Windows hay que usar tcp://
# porque CPython no expone AF_UNIX.
ECOMAP_BUS=tcp://127.0.0.1:8765

# Web
ECOMAP_HOST=127.0.0.1
ECOMAP_PORT=8000
ECOMAP_RELOAD=1

# Render: kms (Pi), window (escritorio con GPU) o headless (contenedor, CI)
ECOMAP_RENDER_MODE=headless
ECOMAP_WIDTH=960
ECOMAP_HEIGHT=540
ECOMAP_FPS=60
# Backend del contexto GL en headless: egl dentro de contenedores Linux.
# ECOMAP_GL_BACKEND=egl

# Preview MJPEG que publica el render en modo headless
ECOMAP_PREVIEW_PORT=8001
ECOMAP_PREVIEW_FPS=5

# Camara (Hito 4)
ECOMAP_CAMERA=fake://
